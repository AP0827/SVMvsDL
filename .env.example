# Root-level env file used by docker-compose to inject build args
# into the frontend image. Copy to .env and fill in.
#
# These are baked into the production bundle at build time; the browser
# reads them as plain JS. Firebase web SDK keys are public by design —
# Firestore Security Rules are what gate access.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where the browser will hit the backend. Default points at the
# host-mapped api port from docker-compose.
VITE_API_BASE_URL=http://localhost:5001
