# Backend environment variables.
# Copy to .env (gitignored) and fill in.

# Path to the Firebase service-account JSON. If unset, firebase_client.py
# auto-discovers any *.json file under app/backend/credentials/.
FIREBASE_CREDENTIALS=

# Comma-separated list of allowed origins for /api/*.
# Use "*" to allow all (NOT recommended for production).
# Default if unset: http://localhost:8080, http://127.0.0.1:8080
CORS_ORIGINS=https://your-dashboard.example.com

# Flask dev server (only used when running `python -m app.backend.app`)
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=0

# Set to 1 to enable the /test-firestore smoke endpoint. Leave unset in prod.
ENABLE_FIRESTORE_TEST=

# Where the websocket server should send prediction requests. Defaults to
# http://127.0.0.1:5001 when running directly; docker-compose overrides this
# to http://api:5001 so the ws container can reach the api container.
API_BASE_URL=http://127.0.0.1:5001
