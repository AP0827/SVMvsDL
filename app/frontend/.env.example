# Firebase Web SDK configuration
# Copy this file to `.env` and fill in the values from your Firebase project's
# web app config (Project settings → General → Your apps → Web app).
# Vite only exposes variables that start with VITE_ to client code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL. Defaults to http://localhost:5001 if unset.
# In Docker, leave as-is — the browser still hits the host-mapped port.
VITE_API_BASE_URL=http://localhost:5001
